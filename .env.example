# Kopirajte v .env. Datoteke .env ne dodajte v Git.
DATABASE_PATH=data/cycling_analyzer.db
FIT_INBOX=fit_inbox
LOG_LEVEL=INFO
MAX_HEART_RATE=190

# Uporabljeno šele v naslednji fazi (AI poročila).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Uradni Garmin Connect Personal API; adapter sledi v naslednji fazi.
GARMIN_PERSONAL_API_KEY=

